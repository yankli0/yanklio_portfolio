---
import BaseLayout from "./BaseLayout.astro";
import NoteHeader from "../components/NoteHeader.astro";
import type { BlogPost } from "../data/blog";
interface Props {
    post: BlogPost;
}
const { post } = Astro.props;
const { title, description, image } = post.data;
---

<BaseLayout pageTitle={title} pageDescription={description} pageImage={image} pageType="article">
    <div class="page-container page-top article-page">
        <a class="link back-link" href="/blog"><span aria-hidden="true">←</span> All notes</a>
        <NoteHeader post={post} isDetail />
        <article class="post-content"><slot /></article>
    </div>
</BaseLayout>
<style>
    .article-page {
        max-width: var(--content-max);
    }
    .back-link {
        display: inline-block;
        margin-bottom: var(--content-inset);
    }
    .post-content {
        margin-top: var(--section-gap);
        overflow-wrap: anywhere;
    }
    .post-content :global(p),
    .post-content :global(ul),
    .post-content :global(ol) {
        font-size: var(--text-body);
        line-height: 1.95;
        margin-bottom: var(--space-5);
    }
    .post-content :global(ul) {
        list-style: disc;
        padding-left: var(--space-5);
    }
    .post-content :global(ol) {
        list-style: decimal;
        padding-left: var(--space-5);
    }
    .post-content :global(li) {
        margin-bottom: var(--space-1);
    }
    .post-content :global(blockquote) {
        background: var(--color-base-200);
        border-left: 3px solid var(--color-primary);
        padding: var(--content-inset);
        margin-block: var(--space-6);
    }
    .post-content :global(blockquote p:last-child) {
        margin-bottom: 0;
    }
    .post-content :global(code) {
        background: var(--color-base-200);
        border-radius: var(--radius-field);
        padding: 0.15em 0.35em;
    }
    .post-content :global(pre) {
        border: 1px solid var(--color-base-300);
        border-radius: var(--radius-box);
        overflow-x: auto;
        padding: var(--content-inset);
        margin-block: var(--space-6);
    }
    .post-content :global(pre code) {
        background: transparent;
        padding: 0;
    }
    .post-content :global(a) {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
</style>
