---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogList from "../components/BlogList.astro";

import RSSButton from "../components/header/RSSButton.astro";
import { getBlogPosts } from "../data/blog";
const allPosts = await getBlogPosts();
---

<BaseLayout pageTitle="Notes" pageDescription="Notes on web development, programming, and technology.">
    <div class="page-container page-top">
        <section class="archive-intro" aria-labelledby="archive-title">
            <div>
                <h1 id="archive-title" class="page-title">Notes<span class="text-primary">.</span></h1>
                <p class="archive-description">
                    I write down the things that make me curious—technology, games, music, and whatever comes next.
                    There is always something interesting to learn.
                </p>
            </div>
        </section>
        <section class="archive-sources" aria-labelledby="availability-title">
            <div>
                <p id="availability-title" class="page-kicker">Available on</p>
            </div>
            <div class="source-buttons">
                <RSSButton />
                <button
                    class="btn btn-outline"
                    type="button"
                    disabled
                    aria-label="Additional publishing destination coming soon">???</button
                >
                <button
                    class="btn btn-outline"
                    type="button"
                    disabled
                    aria-label="Additional publishing destination coming soon">???</button
                >
            </div>
        </section>
        <div class="archive-heading section-rule">
            <h2>All notes</h2><span class="badge badge-outline">{String(allPosts.length).padStart(2, "0")}</span>
        </div>
        <BlogList posts={allPosts} />
    </div>
</BaseLayout>
<style>
    .archive-intro {
        max-width: var(--text-max);
    }
    h1 {
        font-size: var(--text-section-title);
        margin-bottom: var(--space-4);
    }
    .archive-description {
        line-height: var(--leading-body);
    }
    .archive-sources {
        display: flex;
        align-items: center;
        gap: var(--space-5);
        margin-block: var(--space-5) var(--space-8);
    }
    .source-buttons {
        display: flex;
        gap: var(--space-2);
    }
    .archive-heading {
        margin-bottom: var(--space-5);
    }
    .archive-heading h2 {
        font-size: var(--text-body);
    }
    @media (max-width: 700px) {
        .archive-sources {
            flex-direction: column;
            align-items: stretch;
            gap: var(--space-2);
        }
        .source-buttons {
            width: 100%;
        }
        .source-buttons > :global(*) {
            flex: 1;
            min-width: 0;
            min-height: 2.75rem;
        }
    }
</style>
