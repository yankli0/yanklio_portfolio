---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogList from "../components/BlogList.astro";
import RSSButton from "../components/header/RSSButton.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getBlogPosts } from "../data/blog";
const allPosts = await getBlogPosts();
---

<BaseLayout pageTitle="Notes" pageDescription="Notes on web development, programming, and technology.">
    <div class="page-container page-top notes-page">
        <header class="archive-intro">
            <h1 class="sr-only">Notes</h1>
            <p>I write down the things that make me curious—technology, games, music, and whatever comes next.</p>
        </header>
        <section class="archive-follow" aria-labelledby="follow-title">
            <SectionHeader id="follow-title" title="Follow along" compact />
            <div class="archive-sources">
                <RSSButton />
                <button
                    class="btn btn-ghost btn-xs"
                    type="button"
                    disabled
                    aria-label="Additional publishing destination coming soon">???</button
                >
                <button
                    class="btn btn-ghost btn-xs"
                    type="button"
                    disabled
                    aria-label="Additional publishing destination coming soon">???</button
                >
            </div>
        </section>
        <h2 class="sr-only">All notes</h2>
        <BlogList posts={allPosts} />
    </div>
</BaseLayout>
<style>
    .archive-intro p {
        line-height: var(--leading-body);
        margin: 0;
    }
    .archive-follow {
        margin-block: var(--section-gap);
    }
    .archive-sources {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        margin-top: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-small);
    }
    .archive-sources .btn {
        border: 0;
        box-shadow: none;
    }
</style>
