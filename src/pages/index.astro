---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatArt from "../components/CatArt.astro";
import { site, socialLinks, toolboxGroups } from "../config/site";
---

<BaseLayout
    pageDescription="Personal website and notes by Yaroslav, a full-stack developer working with TypeScript, React, Node.js, and Python."
>
    <div class="page-container home-page">
        <section class="intro" aria-labelledby="intro-title">
            <div class="intro-copy">
                <p class="page-kicker">Full-stack developer / {site.location}</p>
                <h1 id="intro-title" class="page-title">{site.name}<span class="text-primary">.</span></h1>
                <p class="intro-description">
                    I’m drawn to interesting technical products and the systems behind them. Most of my experience is in
                    the JavaScript ecosystem, working across both frontend and backend.
                </p>
                <p class="intro-description">
                    I’m also moving deeper into Java world and mastering cloud infrastructure and DevOps.
                </p>
                <div class="intro-actions">
                    <a class="btn btn-primary" href="/blog">Read my notes <span aria-hidden="true">↗</span></a>
                    <span class="location-note">Based in Poznań, PL<br />Open to remote work too</span>
                </div>
            </div>
            <div class="cat-scene bg-base-200 rounded-box">
                <div class="cat-scene__label"><span>AFK, probably</span><span aria-hidden="true">[ ~ ]</span></div>
                <div class="cat-scene__art"><CatArt /></div>
                <p class="cat-scene__caption">A little curiosity. A lot of coffee.</p>
            </div>
        </section>
        <section class="toolbox-section" aria-labelledby="toolbox-title">
            <div class="section-heading section-rule">
                <p class="page-kicker">01 / The everyday kit</p>
                <h2 id="toolbox-title">Toolbox</h2>
            </div>
            <div class="toolbox-table">
                <table class="table">
                    <caption class="sr-only">Technologies and tools I work with</caption>
                    <tbody>
                        {
                            toolboxGroups.map(({ label, tools }) => (
                                <tr>
                                    <>
                                        <th scope="row">{label}</th>
                                        <td>
                                            <div class="toolbox-tools">
                                                {tools.split(" · ").map((tool) => (
                                                    <span class="badge badge-outline">{tool}</span>
                                                ))}
                                            </div>
                                        </td>
                                    </>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="contact-section" aria-labelledby="links-title">
            <div>
                <p class="page-kicker">02 / Elsewhere</p><h2 id="links-title">
                    Find me online<span aria-hidden="true">↗</span>
                </h2>
            </div>
            <div class="contact-links">
                {
                    socialLinks.map(({ href, label }) => (
                        <a
                            class="btn btn-outline"
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${label} (opens in a new tab)`}
                        >
                            {label}
                            <span aria-hidden="true">↗</span>
                        </a>
                    ))
                }
            </div>
        </section>
    </div>
</BaseLayout>
<style>
    .home-page {
        padding-block: var(--page-top) var(--space-8);
    }
    .intro {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-7);
        align-items: stretch;
    }
    .intro-copy {
        min-width: 0;
        padding-block: var(--space-3);
    }
    h1 {
        margin-block: var(--space-4) var(--space-5);
    }
    .intro-description {
        max-width: 38rem;
        line-height: var(--leading-body);
        margin-bottom: var(--space-4);
    }
    .intro-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-5);
        margin-top: var(--space-5);
    }
    .location-note {
        font-size: var(--text-small);
        line-height: 1.7;
    }
    .cat-scene {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: var(--rule-width) solid var(--rule-color);
    }
    .cat-scene__label {
        display: flex;
        justify-content: space-between;
        padding: var(--space-2) var(--space-4);
        font-size: var(--text-small);
        text-transform: uppercase;
        border-bottom: var(--rule-width) solid var(--rule-color);
        background: var(--color-primary);
        color: var(--color-primary-content);
    }
    .cat-scene__art {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-6) var(--space-3);
    }
    .cat-scene__caption {
        font-size: var(--text-small);
        text-align: center;
        padding: var(--space-3);
        border-top: var(--rule-width) solid var(--rule-color);
    }
    .toolbox-section {
        margin-top: var(--space-8);
    }
    .section-heading {
        flex-direction: row-reverse;
    }
    .toolbox-table {
        min-width: 0;
    }
    .table th {
        width: 30%;
        padding-left: 0;
        vertical-align: top;
        padding-block: var(--space-4);
        text-transform: uppercase;
        font-size: var(--text-small);
        font-weight: 500;
    }
    .table td {
        padding-block: var(--space-4);
        padding-right: 0;
    }
    .table tr {
        border-color: var(--rule-color);
    }
    .toolbox-tools {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
    }
    .badge {
        font-size: var(--text-small);
    }
    .contact-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-6);
        margin-top: var(--space-7);
        padding: var(--space-6);
        border: var(--rule-width) solid var(--rule-color);
        background: var(--color-primary);
        color: var(--color-primary-content);
    }
    .contact-section .page-kicker {
        color: inherit;
    }
    .contact-section h2 {
        font-size: var(--text-section-title);
        line-height: 1.2;
        letter-spacing: -0.06em;
        margin-top: var(--space-3);
        text-transform: uppercase;
    }
    .contact-section h2 span {
        margin-left: var(--space-4);
    }
    .contact-links {
        display: flex;
        gap: var(--space-3);
    }
    .contact-links .btn {
        background: var(--color-base-100);
        color: var(--color-base-content);
    }
    .contact-links .btn:hover {
        background: var(--color-base-200);
    }
    @media (max-width: 700px) {
        .intro {
            grid-template-columns: 1fr;
        }
        .cat-scene {
            min-height: 17rem;
        }
        .contact-section {
            align-items: stretch;
            flex-direction: column;
            padding: var(--space-5);
        }
        .contact-links .btn {
            flex: 1;
        }
        .table th {
            width: 30%;
        }
        .section-heading .page-kicker {
            max-width: 9rem;
            text-align: right;
        }
    }
    @media (max-width: 420px) {
        .table th {
            width: 7.25rem;
            font-size: 0.65rem;
        }
        .intro-actions {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>
