---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatArt from "../components/CatArt.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { socialLinks, toolboxGroups } from "../config/site";
---

<BaseLayout
    pageDescription="Personal website and notes by Yaroslav, a full-stack developer working with TypeScript, React, Node.js, and Python."
>
    <div class="page-container page-top home-page">
        <h1 id="intro-title" class="sr-only">Home</h1>
        <section class="intro" aria-labelledby="intro-title">
            <div class="intro-copy">
                <p>Hi, I’m Yaroslav, a full-stack developer based in Poznań, Poland.</p>
                <p>
                    I like interesting technical products and the systems behind them. Most of my experience is in the
                    JavaScript ecosystem, working across frontend and backend. I’m open to remote work.
                </p>
                <section class="contact" aria-labelledby="contact-title">
                    <SectionHeader id="contact-title" title="Get in touch" compact />
                    <ul class="social-links" aria-label="Social profiles">
                        {
                            socialLinks.map(({ href, label }) => (
                                <li>
                                    <a
                                        class="link"
                                        href={href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`${label} (opens in a new tab)`}
                                    >
                                        {label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </section>
            </div>
            <div class="cat-scene"><CatArt /></div>
        </section>
        <section class="toolbox-section" aria-labelledby="toolbox-title">
            <SectionHeader id="toolbox-title" title="Toolbox" />
            <table class="table toolbox-table">
                <caption class="sr-only">Technologies and tools I work with</caption>
                <colgroup><col class="toolbox-category" /><col /></colgroup>
                <tbody
                    >{
                        toolboxGroups.map(({ label, tools }) => (
                            <tr>
                                <>
                                    <th scope="row">{label}</th>
                                    <td>{tools}</td>
                                </>
                            </tr>
                        ))
                    }</tbody
                >
            </table>
        </section>
    </div>
</BaseLayout>
<style>
    .intro {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: var(--space-7);
        align-items: center;
    }
    .intro-copy {
        min-width: 0;
    }
    .intro-copy p {
        line-height: var(--leading-body);
        margin-top: var(--space-5);
        max-width: 38rem;
    }
    .intro-copy > p:first-child {
        margin-top: 0;
    }
    .contact {
        margin-top: var(--space-6);
    }
    .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
        margin-top: var(--space-2);
    }
    .cat-scene {
        container-type: inline-size;
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 0;
    }
    .toolbox-section {
        margin-top: var(--space-8);
    }
    .toolbox-table {
        table-layout: fixed;
    }
    .toolbox-category {
        width: 10rem;
    }
    .toolbox-table th {
        width: 10rem;
        padding-left: var(--space-3);
        background: var(--color-base-200);
        border-right: var(--rule-width) solid var(--rule-color);
        font-family: var(--font-mono);
        font-size: var(--text-small);
        font-weight: 500;
        text-transform: uppercase;
        vertical-align: top;
    }
    .toolbox-table td {
        padding-right: 0;
        font-size: var(--text-body);
        line-height: 1.7;
    }
    .toolbox-table th,
    .toolbox-table td {
        padding-block: var(--space-3);
        border-bottom: var(--rule-width) solid var(--rule-color);
    }
    @media (max-width: 700px) {
        .intro {
            grid-template-columns: 1fr;
            gap: var(--space-5);
        }
        .cat-scene {
            padding-block: var(--space-3);
        }
        .toolbox-table th {
            width: 8rem;
            padding-inline: var(--space-2);
            font-size: 0.65rem;
        }
        .toolbox-category {
            width: 8rem;
        }
    }
</style>
