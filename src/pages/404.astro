---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout pageTitle="Not found">
    <section class="hero page-container not-found" aria-labelledby="not-found-title">
        <div class="hero-content error-content">
            <p class="error-code text-secondary" aria-hidden="true">404</p>
            <PageHeader id="not-found-title" title="Page not found" />
            <p class="error-message">The page may have moved, or it never existed.</p>
            <a class="link" href="/"><span aria-hidden="true">←</span> Back home</a>
        </div>
    </section>
</BaseLayout>
<style>
    .not-found {
        min-height: 70svh;
        padding-block: var(--space-9);
    }
    .error-content {
        flex-direction: column;
        text-align: center;
        gap: var(--space-5);
        padding: 0;
    }
    .error-code {
        font-size: clamp(4rem, 12vw, 7rem);
        letter-spacing: -0.1em;
        line-height: 1;
    }
    .error-message {
        max-width: 30rem;
        line-height: var(--leading-body);
    }
</style>
