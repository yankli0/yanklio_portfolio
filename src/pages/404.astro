---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Not found">
    <section class="hero page-container not-found" aria-labelledby="not-found-title">
        <div class="hero-content error-content">
            <p class="error-code text-primary" aria-hidden="true">404</p>
            <p class="page-kicker">Route unavailable</p>
            <h1 id="not-found-title">Nothing here.</h1>
            <p class="error-message">The page may have moved, or it never existed.</p>
            <a class="btn btn-primary" href="/"><span aria-hidden="true">←</span> Back home</a>
        </div>
    </section>
</BaseLayout>
<style>
    .not-found {
        min-height: 70svh;
        padding-block: var(--space-9);
    }
    .error-content {
        flex-direction: column;
        text-align: center;
        gap: var(--space-5);
        padding: 0;
    }
    .error-code {
        font-size: clamp(6rem, 20vw, 13rem);
        letter-spacing: -0.1em;
        line-height: 1;
    }
    h1 {
        font-size: var(--text-section-title);
        line-height: 1.1;
        letter-spacing: -0.06em;
    }
    .error-message {
        max-width: 30rem;
        line-height: var(--leading-body);
    }
</style>
