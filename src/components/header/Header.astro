---
import Logo from "../Logo.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header class="site-header bg-base-100">
    <div class="masthead-strip">
        <div class="page-container strip-inner">
            <span>Make it make sense</span><span class="strip-location">Poznań, PL</span>
        </div>
    </div>
    <div class="navbar page-container masthead">
        <div class="navbar-start"><Logo /></div>
        <div class="navbar-end">
            <span class="masthead-caption">A developer’s corner<br />of the internet.</span><ThemeIcon />
        </div>
    </div>
    <div class="navigation-row">
        <div class="page-container navigation-inner">
            <Navigation /><span class="navigation-caption">Code, notes & everything in between.</span>
        </div>
    </div>
</header>
<style>
    .site-header {
        border-bottom: var(--rule-width) solid var(--rule-color);
    }
    .masthead-strip {
        background: var(--color-base-content);
        color: var(--color-base-100);
        padding: var(--space-1) var(--page-gutter);
    }
    .strip-inner {
        display: flex;
        justify-content: space-between;
        gap: var(--space-3);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .masthead {
        min-height: var(--header-height);
        width: calc(100% - var(--page-gutter) * 2);
        padding: var(--space-3) 0;
    }
    .navbar-start {
        width: auto;
        flex: 1;
    }
    .navbar-end {
        width: auto;
        gap: var(--space-5);
    }
    .masthead-caption {
        font-size: var(--text-small);
        text-align: right;
        line-height: 1.6;
    }
    .navigation-row {
        padding-inline: var(--page-gutter);
        border-top: var(--rule-width) solid var(--rule-color);
        background: var(--color-base-200);
    }
    .navigation-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .navigation-caption {
        font-size: var(--text-small);
    }
    @media (max-width: 700px) {
        .masthead-caption,
        .navigation-caption,
        .strip-location {
            display: none;
        }
        .strip-inner {
            font-size: 0.6rem;
        }
    }
</style>
