---
import Logo from "../Logo.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header class="site-header bg-base-100 layout-rule--bottom">
    <div class="masthead-strip bg-base-content text-base-100">
        <p class="session-status">
            <span class="session-status__glyph" aria-hidden="true" data-session-glyph>✻</span>
            <span class="session-status__phrase" data-session-phrase>Syncing a new album</span>
            <span class="sr-only">
                Live activity indicator. The symbol and wording change automatically and have no controls.
            </span>
        </p>
    </div>
    <div class="navbar page-container masthead">
        <Logo />
        <div class="masthead-details">
            <p>Full-stack developer<br /><span>Poznań, PL</span></p>
            <ThemeIcon />
        </div>
    </div>
    <div class="navigation-row bg-base-200 layout-rule--top">
        <div class="page-container"><Navigation /></div>
    </div>
</header>

<script>
    const glyphInterval = 300;
    const phraseInterval = 10000;
    const phrasesUrl = "/data/session-phrases.json";
    const glyphs = ["·", "✻", "✽", "✶", "✳", "✢"];
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const phrase = document.querySelector<HTMLElement>("[data-session-phrase]");
    const glyph = document.querySelector<HTMLElement>("[data-session-glyph]");

    if (!reducedMotion && glyph) {
        let glyphIndex = Math.max(glyphs.indexOf(glyph.textContent ?? ""), 0);
        setInterval(() => {
            glyphIndex = (glyphIndex + 1) % glyphs.length;
            glyph.textContent = glyphs[glyphIndex] ?? "";
        }, glyphInterval);
    }

    if (!reducedMotion && phrase) {
        addEventListener("load", () => {
            void fetch(phrasesUrl)
                .then((response) => response.json())
                .then((items: string[]) => {
                    if (!Array.isArray(items) || items.length < 2) return;
                    let i = Math.max(items.indexOf(phrase.textContent ?? ""), 0);
                    phrase.classList.add("session-status__phrase--sweeping");
                    setInterval(() => {
                        i = (i + 1 + Math.floor(Math.random() * (items.length - 1))) % items.length;
                        phrase.textContent = items[i] ?? "";
                        phrase.animate(
                            [
                                { opacity: 0, transform: "translateY(0.35em)" },
                                { opacity: 1, transform: "translateY(0)" },
                            ],
                            { duration: 260, easing: "ease-out" },
                        );
                    }, phraseInterval);
                })
                .catch(() => {});
        });
    }
</script>

<style>
    .masthead-strip {
        padding-block: var(--space-1);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.5;
    }
    .session-status {
        --sweep-dim: color-mix(in oklab, var(--color-base-100) 75%, var(--color-base-content));
        align-items: center;
        display: flex;
        gap: var(--space-2);
        justify-content: center;
        margin: 0;
    }
    .session-status__glyph {
        flex: none;
        line-height: 1;
        width: 1.1em;
    }
    .session-status__phrase--sweeping {
        -webkit-background-clip: text;
        background-clip: text;
        background-image: linear-gradient(
            90deg,
            var(--sweep-dim) 0%,
            var(--sweep-dim) 38%,
            var(--color-base-100) 50%,
            var(--sweep-dim) 62%,
            var(--sweep-dim) 100%
        );
        background-size: 200% 100%;
        color: transparent;
        animation: session-sweep 2.4s linear infinite alternate;
        -webkit-text-fill-color: transparent;
    }
    @keyframes session-sweep {
        from {
            background-position: 100% 0;
        }
        to {
            background-position: 0% 0;
        }
    }
    .masthead {
        justify-content: space-between;
        min-height: var(--header-height);
        padding: var(--space-3) 0;
        width: calc(100% - var(--page-gutter) * 2);
    }
    .masthead-details {
        align-items: center;
        display: flex;
        gap: var(--space-5);
    }
    .masthead-details p {
        font-size: var(--text-small);
        line-height: 1.6;
        text-align: right;
    }
    .navigation-row {
        padding-inline: var(--space-2);
    }
    @media (prefers-reduced-motion: reduce) {
        .session-status__phrase--sweeping {
            animation: none;
            background-image: none;
            color: var(--color-base-100);
            -webkit-text-fill-color: currentColor;
        }
    }
    @media (max-width: 700px) {
        .masthead-details p {
            display: none;
        }
    }
</style>
