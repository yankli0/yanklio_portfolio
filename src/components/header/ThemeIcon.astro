---
import { Icon } from "astro-icon/components";
---

<button
    class="btn btn-ghost btn-square theme-toggle"
    aria-label="Switch color theme"
    aria-pressed="false"
    type="button"
    data-theme-toggle
>
    <Icon class="sun" name="ic:baseline-wb-sunny" aria-hidden="true" />
    <Icon class="moon" name="ic:baseline-dark-mode" aria-hidden="true" />
</button>
<style>
    .sun {
        display: none;
    }
    :global([data-theme="forest"]) .sun {
        display: block;
    }
    :global([data-theme="forest"]) .moon {
        display: none;
    }
</style>
