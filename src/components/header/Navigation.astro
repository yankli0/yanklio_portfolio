---
import { isNavigationItemActive, navigationItems } from "../../config/site";
---

<nav class="tabs site-tabs" aria-label="Primary navigation">
    {
        navigationItems.map(({ href, label }, index) => (
            <a
                href={href}
                class:list={["tab", { "tab-active": isNavigationItemActive(Astro.url.pathname, href) }]}
                aria-current={isNavigationItemActive(Astro.url.pathname, href) ? "page" : undefined}
            >
                <span class="tab-number" aria-hidden="true">
                    0{index + 1}
                </span>
                {label}
                <span class="tab-arrow" aria-hidden="true">
                    ↗
                </span>
            </a>
        ))
    }
</nav>
<style>
    .site-tabs {
        flex-wrap: nowrap;
    }
    .site-tabs > .tab {
        min-height: 2.8rem;
        min-width: 10rem;
        gap: var(--space-3);
        border-right: var(--rule-width) solid var(--rule-color);
        color: var(--color-base-content);
        text-transform: uppercase;
        font-size: var(--text-small);
        letter-spacing: 0.06em;
    }
    .site-tabs > .tab:first-child {
        border-left: var(--rule-width) solid var(--rule-color);
    }
    .site-tabs > .tab-active {
        background: var(--color-primary);
        color: var(--color-primary-content);
    }
    .site-tabs > .tab:hover {
        background: var(--color-base-content);
        color: var(--color-base-100);
    }
    .tab-number {
        font-size: 0.65rem;
    }
    .tab-arrow {
        margin-left: var(--space-3);
    }
    @media (max-width: 700px) {
        .site-tabs {
            width: 100%;
        }
        .site-tabs > .tab {
            flex: 1;
            min-width: 0;
        }
    }
</style>
