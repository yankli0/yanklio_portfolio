---
import type { BlogPost } from "../data/blog";
import BlogTag from "./BlogTag.astro";
import PageHeader from "./PageHeader.astro";
interface Props {
    isDetail?: boolean;
    post: BlogPost;
}
const { post, isDetail = false } = Astro.props;
const href = `/blog/${post.id}`;
const longDate = post.data.pubDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
});
const Root = isDetail ? "header" : "article";
const titleId = `note-${post.id.replace(/[^a-zA-Z0-9_-]/g, "-")}-title`;
const readLabel = `Read ${post.data.title}`;
---

<Root class:list={["note-header", !isDetail && "layout-rule--bottom"]} aria-labelledby={titleId}>
    <div class="note-header__body">
        {
            isDetail ? (
                <PageHeader id={titleId} title={post.data.title} />
            ) : (
                <h2 class="note-header__title">
                    <a class="note-title-link" href={href}>
                        {post.data.title}
                    </a>
                </h2>
            )
        }
        <div class="note-header__meta">
            <time datetime={post.data.pubDate.toISOString()}>{longDate}</time>
        </div>
        <div class="note-header__panel">
            <p class="note-header__summary">{post.data.description}</p>
            <div class="note-header__footer">
                <ul class="note-header__tags" aria-label="Tags">
                    {
                        post.data.tags.map((tag) => (
                            <li>
                                <BlogTag text={tag} />
                            </li>
                        ))
                    }
                </ul>
                {
                    !isDetail && (
                        <a class="link" href={href} aria-label={readLabel}>
                            Read note <span aria-hidden="true">→</span>
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</Root>
<style>
    .note-header {
        padding-bottom: var(--space-5);
    }
    .note-header__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }
    .note-header__title {
        font-size: var(--text-card-title);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.15;
        margin: 0;
        overflow-wrap: anywhere;
    }
    .note-header__panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-top: var(--space-2);
    }
    .note-header__meta {
        align-items: baseline;
        color: color-mix(in oklch, var(--color-base-content) 70%, var(--color-base-100));
        display: flex;
        flex-wrap: wrap;
        font-size: var(--text-small);
        gap: var(--space-2);
        justify-content: space-between;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .note-title-link {
        text-decoration: none;
    }
    .note-title-link:hover {
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }
    .note-header__summary {
        line-height: var(--leading-body);
        margin: 0;
    }
    .note-header__footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
    }
    .note-header__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }
    @media (max-width: 420px) {
        .note-header__footer {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>
