---
import type { BlogPost } from "../data/blog";
import BlogTag from "./BlogTag.astro";
interface Props {
    isDetail?: boolean;
    post: BlogPost;
}
const { post, isDetail = false } = Astro.props;
const href = `/blog/${post.id}`;
const longDate = post.data.pubDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
});
const Root = isDetail ? "header" : "article";
const titleId = `note-${post.id.replace(/[^a-zA-Z0-9_-]/g, "-")}-title`;
---

<Root class:list={["card card-border note-header", { "note-header--detail": isDetail }]} aria-labelledby={titleId}>
    <div class="card-body">
        <div class="note-header__meta">
            <time datetime={post.data.pubDate.toISOString()}>{longDate}</time><span>By {post.data.author}</span>
        </div>
        {
            isDetail ? (
                <h1 id={titleId}>{post.data.title}</h1>
            ) : (
                <h3 id={titleId}>
                    <a class="note-title-link" href={href}>
                        {post.data.title}
                    </a>
                </h3>
            )
        }
        <p class="note-header__summary">{post.data.description}</p>
        <div class="card-actions note-header__footer">
            <ul class="note-header__tags" aria-label="Tags">
                {
                    post.data.tags.map((tag) => (
                        <li>
                            <BlogTag text={tag} />
                        </li>
                    ))
                }
            </ul>
            {
                isDetail ? (
                    <button class="btn btn-active current-note" type="button" disabled aria-current="page">
                        Open <span aria-hidden="true">↗</span>
                    </button>
                ) : (
                    <a class="btn btn-outline" href={href} aria-label={`Open ${post.data.title}`}>
                        Open <span aria-hidden="true">↗</span>
                    </a>
                )
            }
        </div>
    </div>
</Root>
<style>
    .note-header {
        background: var(--color-base-200);
    }
    .card-body {
        gap: var(--space-5);
        padding: var(--space-6);
    }
    .note-header__meta {
        border-bottom: var(--rule-width) solid var(--rule-color);
        padding-bottom: var(--space-3);
        text-transform: uppercase;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-2);
        font-size: var(--text-small);
        color: var(--color-base-content);
    }
    h1,
    h3 {
        font-size: var(--text-card-title);
        line-height: 1.2;
        letter-spacing: -0.06em;
        font-weight: 500;
        max-width: 52rem;
    }
    .note-title-link {
        text-decoration: none;
    }
    .note-title-link:hover {
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }
    .note-header__summary {
        max-width: var(--text-max);
        line-height: var(--leading-body);
    }
    .note-header__footer {
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
    }
    .note-header__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }
    .current-note:disabled {
        box-shadow: inset 0 2px 0 color-mix(in oklch, var(--color-base-content) 20%, transparent);
        transform: translateY(1px);
    }
    @media (max-width: 700px) {
        .card-body {
            padding: var(--space-5);
        }
    }
    @media (max-width: 420px) {
        .note-header__footer {
            align-items: stretch;
            flex-direction: column;
        }
        .note-header__footer .btn {
            width: 100%;
        }
    }
</style>
