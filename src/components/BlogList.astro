---
import type { BlogPost } from "../data/blog";
import BlogCard from "./BlogCard.astro";

interface Props {
    posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="blog-list" role="list" aria-label="Notes">
    {
        posts.map((post) => (
            <div role="listitem">
                <BlogCard post={post} />
            </div>
        ))
    }
</div>

<style>
    .blog-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-7);
        width: 100%;
        max-width: var(--content-max);
        margin: 0 auto;
    }
</style>
