---
import { site } from "../../config/site";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer bg-base-200">
    <div class="footer footer-horizontal page-container footer-inner">
        <span>© {currentYear} {site.handle}</span>
        <span>Made with love and coffee | v0.8.18</span>
        <span>{site.location}</span>
    </div>
</footer>
<style>
    .site-footer {
        border-top: var(--rule-width) solid var(--rule-color);
        padding: var(--space-6) var(--page-gutter);
    }
    .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        font-size: var(--text-small);
    }
    @media (max-width: 700px) {
        .footer-inner {
            flex-direction: column;
            gap: var(--space-2);
            text-align: center;
        }
    }
</style>
